{
  "name": "iobroker.vis-2-widgets-glashaus",
  "version": "0.1.0",
  "description": "Glashaus: glass design widgets for ioBroker vis-2 (particle backgrounds, energy flow, 3D year skyline, 3D house model, appliances, charts)",
  "author": "djlex83 <djlex83@users.noreply.github.com>",
  "contributors": [
    "djlex83 <djlex83@users.noreply.github.com>"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": "https://github.com/djlex83/ioBroker.vis-2-widgets-glashaus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djlex83/ioBroker.vis-2-widgets-glashaus"
  },
  "keywords": [
    "ioBroker",
    "visualization",
    "vis-2",
    "widgets",
    "glashaus",
    "glass",
    "dashboard",
    "energy",
    "smart home"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/types-vis-2": "~2.20.1",
    "@iobroker/vis-2-widgets-testing": "^2.0.0",
    "@types/node": "^26.6.5",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "main": "widgets/vis-2-widgets-glashaus/customWidgets.js",
  "files": [
    "admin/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "tsx tasks.ts",
    "check": "tsc",
    "lint": "eslint -c eslint.config.mjs tasks.ts && cd src-widgets && eslint -c eslint.config.mjs",
    "build": "tsx tasks.ts",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "test": "mocha ./test/*.test.js",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-widgets && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-widgets && npm i",
    "setup-project": "node tools/glashaus-setup.mjs"
  },
  "bugs": {
    "url": "https://github.com/djlex83/ioBroker.vis-2-widgets-glashaus/issues"
  },
  "readmeFilename": "README.md"
}
